# Copiez ce fichier en .env.local pour le développement (jamais commité, voir .gitignore).
#
# En local avec Supabase CLI (pnpm supabase:start) : les valeurs par défaut ci-dessous
# fonctionnent telles quelles, `supabase start` les affiche aussi dans son résumé.
#
# Avec un projet Supabase hébergé : Project Settings → API, dans le tableau de bord Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
